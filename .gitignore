# Agrivision - Git Ignore File

# Data directories
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
datasets/
uploads/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
env/
.venv/
.env

# IDE settings
.idea/
*.swp
*.swo
*~

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Logs
*.log
logs/
runs/

# OS files
.DS_Store
Thumbs.db

# Docker volumes
docker/data/

# Temporary files
tmp/
temp/
*.tmp
