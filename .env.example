# Agrivision Environment Variables Example
# Copy this file to .env and fill in the values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Model Configuration
MODEL_PATH=models/mobilenetv2_agrivision.pt

# Logging
LOG_LEVEL=INFO

# Security
MAX_FILE_SIZE_MB=5
ALLOWED_EXTENSIONS=jpg,jpeg,png
